# Rust build artifacts
/target

# SQLite (local dev DB; per-worktree, disposable)
*.db*

# Python (scraper runtime: scrape.py + deps)
__pycache__/
*.pyc
.venv/

# Node (fallow dev tool)
node_modules/
package.json
package-lock.json

# Secrets & local config
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/

# Scraped login session (auth cookies — a credential). See Architecture §2.4.
session.json

# Logs
*.log

# OS junk
.DS_Store
Thumbs.db

# Local-only config (user-specific permissions, not shared)
.claude/settings.local.json

# Tool runtime state
.omo/
.codegraph/codegraph.db
.codegraph/daemon.log

# opencode node deps (not the skills/config — those are tracked)
.opencode/node_modules/

# Local/dev skills (not committed)
.opencode/skills/cv/
.opencode/skills/scrape/

# Personal agent tooling (not project code)
.agents/
.roo/

