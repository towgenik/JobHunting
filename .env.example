DATABASE_URL=sqlite://jobagent.db
LLM_ENDPOINT=https://api.anthropic.com/v1/messages
LLM_API_KEY=your-api-key-here
LLM_MODEL=claude-sonnet-4-6
LLM_MOCK=true
# PROFILE_DIR: where profile/index.md lives. Defaults to ./profile.
# PROFILE_DIR=./profile
# LLM_PROVIDER: auto-detected from LLM_ENDPOINT (anthropic.com → anthropic, else openai-compat).
# Set explicitly to override: anthropic | openai
# LLM_PROVIDER=openai
#
# --- Local model example: llama.cpp server (OpenAI-compatible /v1) ---
# No auth (the server ignores the key); model id is whatever the server loaded.
# LLM_ENDPOINT=http://localhost:8080/v1/chat/completions
# LLM_MODEL=local
# LLM_PROVIDER=openai
# LLM_API_KEY=not-required
# Login terminal (kasmvnc-docker): human logs in via noVNC; session.py harvests the
# logged-in cookies over CDP. scrape.py runs its own browser with those cookies.
CDP_URL=http://localhost:9223
SESSION_HOST=jobstreet.com
