DATABASE_URL=sqlite://jobagent.db
LLM_ENDPOINT=https://api.anthropic.com/v1/messages
LLM_API_KEY=your-api-key-here
LLM_MODEL=claude-sonnet-4-6
LLM_MOCK=true
# Login terminal (kasmvnc-docker): human logs in via noVNC; session.py harvests the
# logged-in cookies over CDP. scrape.py runs its own browser with those cookies —
# the container is not in the scrape path (Architecture §2.4).
CDP_URL=http://localhost:9223
SESSION_HOST=jobstreet.co.id
